{
  "name": "stremio-offline",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "shared",
    "addon",
    "service",
    "dashboard"
  ],
  "scripts": {
    "build": "npm run build --workspace shared && npm run build --workspace addon && npm run build --workspace dashboard && npm run build --workspace service",
    "dev:service": "npm run dev --workspace service",
    "dev:dashboard": "npm run dev --workspace dashboard",
    "start:service": "npm run start --workspace service",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
